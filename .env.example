############################################################
# BusTracker — self-hosted docker-compose configuration
# Generated by: ./bustracker install
# Do NOT edit manually unless you know what you're doing.
# One install = one transport company.
############################################################

# --- Postgres ---
POSTGRES_PASSWORD=change-me-strong-password

# --- JWT (shared between Kong, GoTrue, PostgREST) ---
# Must be at least 32 characters
JWT_SECRET=change-me-at-least-32-chars-random-string
JWT_EXPIRY=3600

# --- Supabase service keys (generated by ./bustracker install) ---
ANON_KEY=
SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
INTERNAL_SECRET=change-me-random-string

# --- Supabase internal URLs (used by Next.js container) ---
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=${ANON_KEY}
SUPABASE_SERVICE_ROLE_KEY=${SERVICE_ROLE_KEY}

# --- Site URL used by GoTrue for redirect callbacks ---
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=

# --- Company info (written by ./bustracker install, read by ./bustracker seed) ---
COMPANY_NAME=
COMPANY_TIMEZONE=America/Guayaquil
COMPANY_CONTACT=

# --- Geofence settings (the distance-to-home engine; see docs/geofencing.md) ---
# Alert parents when the bus comes within this distance of the child's home…
APPROACH_RADIUS_M=800
# …or within this many minutes (straight-line ETA), whichever first.
APPROACH_ETA_MIN=5
# Record pickup/drop-off when the bus is within this distance of the home…
ARRIVAL_RADIUS_M=60
# …and has stayed that close for this many seconds (dwell, guards GPS jitter).
ARRIVAL_DWELL_S=15
# A bus position older than this (seconds) is treated as stale (no live ETA).
POSITION_STALE_S=120

# --- Notifications (which events alert guardians; see docs/notifications.md) ---
NOTIFY_ON_APPROACH=on
NOTIFY_ON_BOARD=on
NOTIFY_ON_DROP=on
NOTIFY_ON_RUN_START=on

# --- Guardian accounts ---
# Children's data is account-gated. Keep ON (requires SMTP for email verification).
REQUIRE_GUARDIAN_ACCOUNTS=on

# --- Data retention ---
# Delete the per-run GPS trail (route_point) after this many days.
TRAIL_RETENTION_DAYS=30

# --- SMTP (email-verify guardian accounts) ---
# GoTrue autoconfirms emails when SMTP is left blank (dev / admin-only installs).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=BusTracker
SMTP_ADMIN_EMAIL=

# --- Push notifications (parent alerts when the app is closed; see docs/notifications.md) ---
# FCM (Android) — path to a Firebase service-account JSON under secrets/
PUSH_FCM_CREDENTIALS_FILE=
# APNs (iOS) — path to the .p8 auth key under secrets/, plus its IDs + the app bundle id
PUSH_APNS_KEY_FILE=
PUSH_APNS_KEY_ID=
PUSH_APNS_TEAM_ID=
PUSH_APNS_BUNDLE_ID=

# --- Admin login (used by ./bustracker install) ---
ADMIN_EMAIL=
