# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets never committed
.env
.env.local
.env.*.local
# example files ARE committed so licensees can copy them
!.env.example

# generated during install — contains real JWT keys
docker/kong.yml

# push credentials — never committed (FCM service account / APNs key)
secrets/
*.p8
service-account*.json

# runtime artifacts
backups/
__pycache__/

# Claude / AI assistant files
CLAUDE.md
AGENTS.md

# typescript
*.tsbuildinfo
next-env.d.ts

